#!/usr/bin/env bash
# Stop hook: if this session left changes on a branch with an open PR that are
# not pushed, say so with the PR number.
input="$(command cat)"
cwd="$(jq -r '.cwd // ""' <<<"$input")"
[[ -n "$cwd" ]] && cd "$cwd" 2>/dev/null
git rev-parse --git-dir >/dev/null 2>&1 || exit 0
branch="$(git branch --show-current)"
[[ -z "$branch" || "$branch" =~ ^(main|master|develop)$ ]] && exit 0

dirty="$(git status --porcelain | grep -c .)"
ahead="$(git rev-list --count "@{upstream}..HEAD" 2>/dev/null || echo 0)"
((dirty == 0 && ahead == 0)) && exit 0
command -v gh >/dev/null || exit 0
number="$(gh pr view --json number,state -q 'select(.state == "OPEN") | .number' 2>/dev/null)"
[[ -z "$number" ]] && exit 0

parts=()
((dirty)) && parts+=("$dirty uncommitted file(s)")
((ahead)) && parts+=("$ahead unpushed commit(s)")
action="preflight, then git push"
((dirty)) && action="commit, then $action"
msg="PR #$number ($branch) has $(IFS=,; echo "${parts[*]}" | sed 's/,/ and /'). $action"
jq -nc --arg m "$msg" '{systemMessage: $m}'
